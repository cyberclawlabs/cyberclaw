# CyberClaw Server 生产环境配置模板
# 警告：此文件包含敏感信息，切勿提交到版本控制！
# 复制此文件为 .env 并填入实际生产配置值

# ========================================
# 运行环境（必须设置为 production）
# ========================================
ENVIRONMENT=production

# ========================================
# TLS/HTTPS 配置（生产环境必需）
# ========================================
# 生产环境必须启用 TLS
USE_TLS=true

# TLS 证书路径（必需）
# 推荐使用 Let's Encrypt 免费证书：
#   certbot certonly --standalone -d your-domain.com
TLS_CERT_PATH=/etc/ssl/certs/cyberclaw/cert.pem

# TLS 私钥路径（必需）
TLS_KEY_PATH=/etc/ssl/private/cyberclaw/key.pem

# ========================================
# 服务器配置
# ========================================
SERVER_PORT=443

# 服务绑定地址
CYBERCLAW_ADDR=0.0.0.0:443

# ========================================
# 安全配置（生产环境必需）
# ========================================
# JWT 认证密钥（至少 32 字符，推荐使用 256 位随机字符串）
# 生成命令：openssl rand -base64 48
# 生产环境建议使用 HashiCorp Vault 或 AWS Secrets Manager 管理
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS

# ========================================
# LLM 配置（生产环境）
# ========================================
# LLM 提供商类型
LLM_PROVIDER=openai

# API Key（生产环境建议通过 Secrets Manager 注入）
LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# API Base URL
# LLM_BASE_URL=https://api.openai.com/v1

# 默认模型
LLM_DEFAULT_MODEL=gpt-4

# ========================================
# CORS 配置（生产环境）
# ========================================
# 允许访问的前端域名（逗号分隔），生产环境不要使用通配符
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ========================================
# 速率限制（生产环境推荐值）
# ========================================
# 每秒请求数限制
# RATE_LIMIT_PER_SECOND=10

# 突发请求上限
# RATE_LIMIT_BURST_SIZE=30

# 最大请求体大小（字节）
# MAX_BODY_SIZE=1048576

# ========================================
# 生产环境部署清单
# ========================================
# 部署前请确认以下事项：
#
# 1. TLS 证书已配置且有效
#    检查：openssl x509 -in /etc/ssl/certs/cyberclaw/cert.pem -text -noout
#
# 2. JWT_SECRET 已使用强随机值替换
#    生成：openssl rand -base64 48
#
# 3. 防火墙已配置，仅开放必要端口（443/HTTPS）
#
# 4. 此配置文件不在版本控制中（已在 .gitignore）
#
# 5. LLM_API_KEY 已通过安全渠道注入
