# CyberClaw Server 环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# ========================================
# 安全配置（必需，启动前必须设置）
# ========================================

# JWT 认证密钥（必需，至少 32 字符）
# 警告：服务器启动时若未设置此变量将立即 panic，没有默认值
# 生成命令: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here-at-least-32-characters-long

# ========================================
# 服务器配置
# ========================================
SERVER_PORT=8080

# ========================================
# LLM 配置
# ========================================

# LLM 提供商类型
# 可选值: openai, ark, anthropic, generic, minimax
LLM_PROVIDER=minimax

# LLM API Key（必需）
LLM_API_KEY=your-minimax-api-key-here

# LLM API Base URL
LLM_BASE_URL=https://api.minimax.chat/v1

# 默认模型
LLM_DEFAULT_MODEL=minimax-m2.5

# ========================================
# MiniMax 配置示例
# ========================================
# LLM_PROVIDER=minimax
# LLM_API_KEY=your-minimax-api-key
# LLM_BASE_URL=https://api.minimax.chat/v1
# LLM_DEFAULT_MODEL=minimax-m2.5

# ========================================
# 火山引擎 ARK 配置示例（推荐）
# 文档: https://www.volcengine.com/docs/82379/1928261
# ========================================
# LLM_PROVIDER=ark
# LLM_API_KEY=5ea0f5f8-dcbf-45ba-84d5-5ee79c4d1e4a
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_DEFAULT_MODEL=minimax-abab6.5
#
# 可选: 如果使用 Endpoint ID（推荐，从火山引擎控制台获取）
# ARK_ENDPOINT_ID=ep-xxxxx-xxxxx
#
# 支持的模型:
# - minimax-abab6.5    # MiniMax 6.5
# - minimax-abab6      # MiniMax 6.0
# - doubao-pro-32k     # 豆包 Pro
# - doubao-lite-32k    # 豆包 Lite

# ========================================
# OpenAI 配置示例
# ========================================
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_DEFAULT_MODEL=gpt-4

# ========================================
# Anthropic 配置示例
# ========================================
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-your-key
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# ========================================
# Generic (Ollama 等本地服务) 配置示例
# ========================================
# LLM_PROVIDER=generic
# LLM_API_KEY=not-required
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_DEFAULT_MODEL=llama2

# ========================================
# 运行环境配置
# ========================================
# 设置运行环境。可选值: development (默认), production
# 警告：生产环境 (production) 中必须同时启用 TLS，否则服务器将拒绝启动
ENVIRONMENT=development

# ========================================
# TLS/HTTPS 配置（生产环境必需）
# ========================================
# 是否启用 TLS。生产环境必须设置为 true
# USE_TLS=false

# TLS 证书路径（USE_TLS=true 时必需）
# TLS_CERT_PATH=/path/to/cert.pem

# TLS 私钥路径（USE_TLS=true 时必需）
# TLS_KEY_PATH=/path/to/key.pem

# 生成自签名证书（仅用于测试）：
# openssl req -x509 -newkey rsa:4096 -nodes -keyout key.pem -out cert.pem -days 365
