# CyberClaw 环境配置模板
# 复制此文件为 .env 并填写实际值

# ============================================
# 核心安全配置 (必需)
# ============================================

# 审批签名密钥（HMAC-SHA256）
# 要求：至少 32 字符，建议使用强随机字符串
# 生成方法：openssl rand -hex 32
# ⚠️ 生产环境必须设置，切勿使用示例值
CYBERCLAW_APPROVAL_SECRET=your-32-character-minimum-secret-key-here

# ============================================
# LLM 配置 (可选，根据使用的提供商)
# ============================================

# 通用 LLM 提供商选择
# 可选值: volcengine | openai | anthropic | deepseek | together
# LLM_PROVIDER=volcengine

# 通用 LLM 模型
# LLM_MODEL=minimax-m2.5

# --- 火山引擎方舟（推荐国内用户）---
# 获取地址: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=
# ARK_MODEL=minimax-m2.5
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- OpenAI ---
# 获取地址: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (Claude) ---
# 获取地址: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- DeepSeek ---
# 获取地址: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-xxx

# --- Together AI ---
# 获取地址: https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=xxx

# ============================================
# 数据库配置 (可选)
# ============================================

# PostgreSQL 连接字符串
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberclaw

# Redis 连接字符串
# REDIS_URL=redis://localhost:6379

# ============================================
# 其他配置
# ============================================

# 日志级别 (trace, debug, info, warn, error)
# RUST_LOG=info

# 服务端口
# SERVER_PORT=8080

# 服务绑定地址
# SERVER_HOST=0.0.0.0
