#[tokio::test]
async fn test_list_repos_with_defaults() {
    // 这个测试需要真实的 GitHub token
    if std::env::var("GITHUB_TOKEN").is_err() {
        println!("Skipping test: GITHUB_TOKEN not set");
        return;
    }

    let connector = create_test_connector();

    let request = create_test_request(
        "github.list_repos",
        serde_json::json!({}), // 使用默认参数
    );

    let result = connector.execute(request).await;

    // 如果 token 有效，应该成功
    match result {
        Ok(res) => {
            assert_eq!(res.status, ExecutionStatus::Success);
            assert!(res.output.get("repos").is_some());
        }
        Err(_) => {
            // Token 可能无效，跳过
            println!("Skipping: Invalid token");
        }
    }
}

