//! GitHub Connector 集成测试
//!
//! 这些测试需要 GitHub Personal Access Token 才能运行。
//! 设置环境变量 GITHUB_TOKEN 以启用完整测试。

use cyberclaw_connectors::{GitHubConnector, GitHubAuth, Authenticator, Credentials};
use cyberclaw_connectors::types::{Connector, CapabilityExecutionRequest, ExecutionStatus};
use cyberclaw_core::prelude::*;
use std::sync::Arc;

/// 创建测试用的 GitHub Connector
fn create_test_connector() -> GitHubConnector {
    // 使用环境变量或测试 token
    let token = std::env::var("GITHUB_TOKEN")
        .unwrap_or_else(|_| "test_token_for_unit_tests".to_string());

    let auth = Arc::new(GitHubAuth::from_token(token));
    GitHubConnector::new(auth)
}

/// 创建测试执行请求
fn create_test_request(capability_id: &str, input: serde_json::Value) -> CapabilityExecutionRequest {
    CapabilityExecutionRequest {
        execution_id: ExecutionId::new(),
        trace_id: uuid::Uuid::new_v4().to_string(),
        actor: ActorRef::system(),
        workspace: WorkspaceRef {
            id: WorkspaceId::from_string("test".to_string()).unwrap(),
            path: std::path::PathBuf::from("/tmp"),
        },
        connector_id: ConnectorId::from_string("github".to_string()).unwrap(),
        capability_id: CapabilityId::from_string(capability_id.to_string()).unwrap(),
        input,
    }
}

#[test]
fn test_connector_metadata() {
    let connector = create_test_connector();

    // 验证 ID
    assert_eq!(connector.id().as_ref(), "github");

    // 验证运行时类型
    assert_eq!(connector.runtime(), ConnectorRuntime::Native);

    // 验证能力数量
    assert_eq!(connector.capabilities().len(), 5);
}

#[test]
fn test_capabilities_metadata() {
    let connector = create_test_connector();
    let caps = connector.capabilities();

    // 验证 create_issue
    let create_issue = caps.iter().find(|c| c.id == "github.create_issue").unwrap();
    assert_eq!(create_issue.risk, RiskLevel::Medium);
    assert!(create_issue.effects.contains(&CapabilityEffect::Write));
    assert!(create_issue.effects.contains(&CapabilityEffect::Ticket));

    // 验证 create_pr
    let create_pr = caps.iter().find(|c| c.id == "github.create_pr").unwrap();
    assert_eq!(create_pr.risk, RiskLevel::High);

    // 验证 review_code
    let review_code = caps.iter().find(|c| c.id == "github.review_code").unwrap();
    assert_eq!(review_code.risk, RiskLevel::Medium);

    // 验证 list_repos
    let list_repos = caps.iter().find(|c| c.id == "github.list_repos").unwrap();
    assert_eq!(list_repos.risk, RiskLevel::Low);
    assert!(list_repos.effects.contains(&CapabilityEffect::Read));

    // 验证 search_code
    let search_code = caps.iter().find(|c| c.id == "github.search_code").unwrap();
    assert_eq!(search_code.risk, RiskLevel::Low);
    assert!(search_code.effects.contains(&CapabilityEffect::Network));
}

#[tokio::test]
async fn test_auth_token_cached() {
    let auth = GitHubAuth::from_token("cached_token".to_string());

    // 第一次认证应该返回缓存的 token
    let creds1 = auth.authenticate().await.unwrap();
    match creds1 {
        Credentials::PersonalAccessToken(token) => {
            assert_eq!(token, "cached_token");
        }
        _ => panic!("Expected PersonalAccessToken"),
    }

    // 第二次认证应该返回相同的 token
    let creds2 = auth.authenticate().await.unwrap();
    match creds2 {
        Credentials::PersonalAccessToken(token) => {
            assert_eq!(token, "cached_token");
        }
        _ => panic!("Expected PersonalAccessToken"),
    }
}

#[tokio::test]
async fn test_rate_limiter_basic() {
    use cyberclaw_connectors::RateLimiter;

    let limiter = RateLimiter::new(60); // 60 req/min

    // 应该能够快速获取许可
    let start = std::time::Instant::now();
    limiter.acquire().await.unwrap();
    assert!(start.elapsed().as_millis() < 100);
}

#[tokio::test]
async fn test_rate_limiter_multiple() {
    use cyberclaw_connectors::RateLimiter;

    let limiter = RateLimiter::new(10); // 10 req/min

    // 快速获取多个许可
    for _ in 0..5 {
        limiter.acquire().await.unwrap();
    }

    // 应该在合理时间内完成
    // (实际会有一些延迟，但不应该超过几秒)
}

#[tokio::test]
async fn test_execute_unknown_capability() {
    let connector = create_test_connector();

    let request = create_test_request(
        "github.unknown_capability",
        serde_json::json!({}),
    );

    let result = connector.execute(request).await.unwrap();

    // 应该返回失败状态
    assert_eq!(result.status, ExecutionStatus::Failed);
    assert!(result.error.is_some());
    assert!(result.error.unwrap().contains("Unknown capability"));
}

