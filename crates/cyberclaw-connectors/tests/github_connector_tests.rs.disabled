// --- 以下是需要真实 API 调用的测试 (需要 GITHUB_TOKEN) ---

#[tokio::test]
#[ignore] // 默认忽略，需要手动启用
async fn test_list_repos_integration() {
    let connector = create_test_connector();

    let request = create_test_request(
        "github.list_repos",
        serde_json::json!({
            "visibility": "all",
            "sort": "updated",
        }),
    );

    let result = connector.execute(request).await.unwrap();

    assert_eq!(result.status, ExecutionStatus::Success);

    let repos = result.output.get("repos").unwrap().as_array().unwrap();
    println!("Found {} repositories", repos.len());
}

#[tokio::test]
#[ignore]
async fn test_search_code_integration() {
    let connector = create_test_connector();

    let request = create_test_request(
        "github.search_code",
        serde_json::json!({
            "query": "language:rust",
        }),
    );

    let result = connector.execute(request).await.unwrap();

    assert_eq!(result.status, ExecutionStatus::Success);

    let total_count = result.output.get("total_count").unwrap().as_u64().unwrap();
    println!("Found {} code results", total_count);
}

// --- 错误处理测试 ---

#[tokio::test]
async fn test_invalid_visibility_handled() {
    // 即使参数无效，也应该优雅处理
    let connector = create_test_connector();

    let request = create_test_request(
        "github.list_repos",
        serde_json::json!({
            "visibility": "invalid_value",
        }),
    );

    // 应该使用默认值或返回错误
    let result = connector.execute(request).await;

    // 无论成功或失败，都应该有明确的结果
    assert!(result.is_ok() || result.is_err());
}

// --- 并发测试 ---

#[tokio::test]
async fn test_concurrent_execution() {
    let connector = Arc::new(create_test_connector());

    let mut handles = vec![];

    // 并发执行多个请求
    for i in 0..5 {
        let conn = connector.clone();
        let handle = tokio::spawn(async move {
            let request = create_test_request(
                "github.list_repos",
                serde_json::json!({}),
            );

            conn.execute(request).await
        });
        handles.push(handle);
    }

    // 等待所有请求完成
    for handle in handles {
        let result = handle.await.unwrap();
        // 每个请求都应该有结果 (成功或失败)
        assert!(result.is_ok() || result.is_err());
    }
}

// --- 输入验证测试 ---

#[test]
fn test_input_schema_validation() {
    let connector = create_test_connector();

    // 验证所有能力都有输入 schema
    for cap in connector.capabilities() {
        assert!(!cap.input_schema.is_empty());
        assert!(!cap.output_schema.is_empty());

        // 应该是有效的 JSON
        let _: serde_json::Value = serde_json::from_str(&cap.input_schema)
            .expect(&format!("Invalid input schema for {}", cap.id));
    }
}

// --- 超时测试 ---

#[tokio::test]
async fn test_timeout_configuration() {
    let connector = create_test_connector();

    // 验证所有能力都有超时配置
    for cap in connector.capabilities() {
        // 默认超时应该合理
        assert!(cap.timeouts.execution_ms > 0 || cap.timeouts.execution_ms == 0);
    }
}
