#[tokio::test]
#[ignore]
async fn test_mysql_basic_query() {
    let url = std::env::var("MYSQL_URL")
        .unwrap_or_else(|_| "mysql://root:test@localhost:3306/test".to_string());

    let connector = Arc::new(DatabaseConnector::new("test-mysql"));
    connector
        .register_pool("test".to_string(), &url, DatabaseType::MySQL)
        .await
        .expect("Failed to connect to MySQL");

    // Create table
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE IF NOT EXISTS my_users (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(255), created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Clean
    let truncate = DbExecuteInput {
        database: "test".to_string(),
        sql: "TRUNCATE TABLE my_users".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&truncate).unwrap());
    connector.execute(request).await.unwrap();

    // Insert
    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO my_users (name) VALUES ('Charlie'), ('David')".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.unwrap();

    // Query
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "SELECT id, name FROM my_users ORDER BY id".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.count, 2);
}

