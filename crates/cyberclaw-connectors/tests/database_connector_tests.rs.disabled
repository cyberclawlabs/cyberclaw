//! Integration tests for DatabaseConnector
//!
//! These tests cover PostgreSQL, MySQL, and SQLite databases.
//! To run these tests, you need running database instances:
//!
//! PostgreSQL: `docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=test postgres:15`
//! MySQL: `docker run -d -p 3306:3306 -e MYSQL_ROOT_PASSWORD=test mysql:8`
//! SQLite: In-memory or file-based (no setup needed)

use cyberclaw_connectors::{
    Connector, DatabaseConnector, DatabaseType, DbExecuteInput, DbMigrateInput, DbMigration,
    DbQueryInput, DbTransactionInput,
};
use cyberclaw_core::prelude::*;
use std::sync::Arc;

/// Helper to create a test execution request
fn create_test_request(
    capability_id: &str,
    input: serde_json::Value,
) -> cyberclaw_connectors::CapabilityExecutionRequest {
    cyberclaw_connectors::CapabilityExecutionRequest {
        execution_id: ExecutionId::new(),
        trace_id: "test-trace".to_string(),
        actor: ActorRef::system(),
        workspace: WorkspaceRef::default(),
        connector_id: ConnectorId::from_string("database".to_string()).unwrap(),
        capability_id: CapabilityId::new(capability_id),
        input,
    }
}

// ============================================================================
// SQLite Integration Tests (15 tests - 5 per database type)
// ============================================================================

#[tokio::test]
async fn test_sqlite_basic_query() {
    let connector = Arc::new(DatabaseConnector::new("test-sqlite"));

    // Register SQLite in-memory pool
    connector
        .register_pool("test".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .expect("Failed to register pool");

    // Create a test table
    let create_table = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, age INTEGER)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create_table).unwrap());
    connector.execute(request).await.expect("Failed to create table");

    // Insert test data
    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO users (name, age) VALUES ('Alice', 30), ('Bob', 25)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.expect("Failed to insert data");

    // Query data
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "SELECT * FROM users ORDER BY id".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.expect("Failed to query");

    assert_eq!(result.status, cyberclaw_connectors::ExecutionStatus::Success);

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.count, 2);
    assert_eq!(output.rows[0]["name"].as_str().unwrap(), "Alice");
    assert_eq!(output.rows[1]["name"].as_str().unwrap(), "Bob");
}

#[tokio::test]
async fn test_sqlite_execute_statement() {
    let connector = Arc::new(DatabaseConnector::new("test-sqlite"));
    connector
        .register_pool("test".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .unwrap();

    // Create table
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT, price REAL)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Insert
    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO products (name, price) VALUES ('Widget', 9.99)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbExecuteOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.rows_affected, 1);

    // Update
    let update = DbExecuteInput {
        database: "test".to_string(),
        sql: "UPDATE products SET price = 12.99 WHERE name = 'Widget'".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&update).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbExecuteOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.rows_affected, 1);

    // Delete
    let delete = DbExecuteInput {
        database: "test".to_string(),
        sql: "DELETE FROM products WHERE name = 'Widget'".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&delete).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbExecuteOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.rows_affected, 1);
}

#[tokio::test]
async fn test_sqlite_transaction() {
    let connector = Arc::new(DatabaseConnector::new("test-sqlite"));
    connector
        .register_pool("test".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .unwrap();

    // Setup
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE accounts (id INTEGER PRIMARY KEY, balance INTEGER)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO accounts (balance) VALUES (100), (200)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.unwrap();

    // Transaction: Transfer 50 from account 1 to account 2
    let transaction = DbTransactionInput {
        database: "test".to_string(),
        statements: vec![
            "UPDATE accounts SET balance = balance - 50 WHERE id = 1".to_string(),
            "UPDATE accounts SET balance = balance + 50 WHERE id = 2".to_string(),
        ],
    };
    let request = create_test_request("db.transaction", serde_json::to_value(&transaction).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbTransactionOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.statements_executed, 2);
    assert_eq!(output.rows_affected, 2);

    // Verify balances
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "SELECT balance FROM accounts ORDER BY id".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.rows[0]["balance"].as_i64().unwrap(), 50);
    assert_eq!(output.rows[1]["balance"].as_i64().unwrap(), 250);
}

#[tokio::test]
async fn test_sqlite_migration() {
    let connector = Arc::new(DatabaseConnector::new("test-sqlite"));
    connector
        .register_pool("test".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .unwrap();

    let migrations = DbMigrateInput {
        database: "test".to_string(),
        migrations: vec![
            DbMigration {
                name: "001_create_users".to_string(),
                statements: vec![
                    "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE)"
                        .to_string(),
                ],
            },
            DbMigration {
                name: "002_add_email".to_string(),
                statements: vec!["ALTER TABLE users ADD COLUMN email TEXT".to_string()],
            },
        ],
    };

    let request = create_test_request("db.migrate", serde_json::to_value(&migrations).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbMigrateOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.count, 2);
    assert_eq!(output.migrations_applied.len(), 2);

    // Verify schema
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "PRAGMA table_info(users)".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.count, 3); // id, username, email
}

#[tokio::test]
async fn test_sqlite_connection_pool() {
    let connector = Arc::new(DatabaseConnector::new("test-sqlite"));

    // Register multiple pools
    connector
        .register_pool("db1".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .unwrap();
    connector
        .register_pool("db2".to_string(), "sqlite::memory:", DatabaseType::SQLite)
        .await
        .unwrap();

    // Use pool 1
    let create = DbExecuteInput {
        database: "db1".to_string(),
        sql: "CREATE TABLE test1 (id INTEGER)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Use pool 2
    let create = DbExecuteInput {
        database: "db2".to_string(),
        sql: "CREATE TABLE test2 (id INTEGER)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Verify isolation
    let query = DbQueryInput {
        database: "db1".to_string(),
        sql: "SELECT name FROM sqlite_master WHERE type='table'".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert!(output.rows.iter().any(|r| r["name"] == "test1"));
    assert!(!output.rows.iter().any(|r| r["name"] == "test2"));
}

// ============================================================================
// PostgreSQL Integration Tests (5 tests) - Conditional on POSTGRES_URL
// ============================================================================

#[tokio::test]
#[ignore] // Run with: cargo test --test database_connector_tests -- --ignored
async fn test_postgres_basic_query() {
    let url = std::env::var("POSTGRES_URL")
        .unwrap_or_else(|_| "postgres://postgres:test@localhost:5432/test".to_string());

    let connector = Arc::new(DatabaseConnector::new("test-postgres"));
    connector
        .register_pool("test".to_string(), &url, DatabaseType::PostgreSQL)
        .await
        .expect("Failed to connect to PostgreSQL");

    // Create table
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE IF NOT EXISTS pg_users (id SERIAL PRIMARY KEY, name TEXT, created_at TIMESTAMP DEFAULT NOW())".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Clean up
    let truncate = DbExecuteInput {
        database: "test".to_string(),
        sql: "TRUNCATE TABLE pg_users RESTART IDENTITY".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&truncate).unwrap());
    connector.execute(request).await.unwrap();

    // Insert
    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO pg_users (name) VALUES ('Alice'), ('Bob') RETURNING id".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.unwrap();

    // Query
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "SELECT id, name FROM pg_users ORDER BY id".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert_eq!(output.count, 2);
}

#[tokio::test]
#[ignore]
async fn test_postgres_json_support() {
    let url = std::env::var("POSTGRES_URL")
        .unwrap_or_else(|_| "postgres://postgres:test@localhost:5432/test".to_string());

    let connector = Arc::new(DatabaseConnector::new("test-postgres"));
    connector
        .register_pool("test".to_string(), &url, DatabaseType::PostgreSQL)
        .await
        .unwrap();

    // Create table with JSON column
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE IF NOT EXISTS pg_documents (id SERIAL PRIMARY KEY, data JSONB)"
            .to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    // Insert JSON
    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: r#"INSERT INTO pg_documents (data) VALUES ('{"name": "Test", "count": 42}'::jsonb)"#
            .to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.unwrap();

    // Query JSON
    let query = DbQueryInput {
        database: "test".to_string(),
        sql: "SELECT data FROM pg_documents".to_string(),
    };
    let request = create_test_request("db.query", serde_json::to_value(&query).unwrap());
    let result = connector.execute(request).await.unwrap();

    let output: cyberclaw_connectors::DbQueryOutput =
        serde_json::from_value(result.output).unwrap();
    assert!(output.count > 0);
}

#[tokio::test]
#[ignore]
async fn test_postgres_transaction() {
    let url = std::env::var("POSTGRES_URL")
        .unwrap_or_else(|_| "postgres://postgres:test@localhost:5432/test".to_string());

    let connector = Arc::new(DatabaseConnector::new("test-postgres"));
    connector
        .register_pool("test".to_string(), &url, DatabaseType::PostgreSQL)
        .await
        .unwrap();

    // Setup
    let create = DbExecuteInput {
        database: "test".to_string(),
        sql: "CREATE TABLE IF NOT EXISTS pg_accounts (id SERIAL PRIMARY KEY, balance INTEGER)"
            .to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&create).unwrap());
    connector.execute(request).await.unwrap();

    let truncate = DbExecuteInput {
        database: "test".to_string(),
        sql: "TRUNCATE TABLE pg_accounts RESTART IDENTITY".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&truncate).unwrap());
    connector.execute(request).await.unwrap();

    let insert = DbExecuteInput {
        database: "test".to_string(),
        sql: "INSERT INTO pg_accounts (balance) VALUES (1000), (2000)".to_string(),
    };
    let request = create_test_request("db.execute", serde_json::to_value(&insert).unwrap());
    connector.execute(request).await.unwrap();

    // Transaction
    let transaction = DbTransactionInput {
        database: "test".to_string(),
        statements: vec![
            "UPDATE pg_accounts SET balance = balance - 100 WHERE id = 1".to_string(),
            "UPDATE pg_accounts SET balance = balance + 100 WHERE id = 2".to_string(),
