{
  "uid": "cyberclaw-overview",
  "title": "CyberClaw — Server Overview",
  "tags": ["cyberclaw", "staging"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Process uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds{job=\"cyberclaw-server\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Resident memory",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"cyberclaw-server\"}", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open file descriptors",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "process_open_fds{job=\"cyberclaw-server\"}", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "OS threads",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "process_threads{job=\"cyberclaw-server\"}", "refId": "A" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU seconds total (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"cyberclaw-server\"}[1m])",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory (resident)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"cyberclaw-server\"}", "refId": "A", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Executions / s (status)",
      "description": "App-level counter: cyberclaw_observability::EXECUTION_COUNT. Empty until first execution runs.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(cyberclaw_executions_total[1m]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Capability invocations / s (capability_id)",
      "description": "App-level counter: CAPABILITY_INVOCATION_COUNT. Empty until first invocation.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (capability_id) (rate(cyberclaw_capability_invocations_total[1m]))",
          "refId": "A",
          "legendFormat": "{{capability_id}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Review queue size",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "cyberclaw_review_queue_size", "refId": "A" }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Execution duration p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cyberclaw_execution_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(cyberclaw_execution_duration_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
