# CyberClaw Governance Rules — declarative agent × capability policy
#
# ## Auto-discovery (v1.2.15+)
#
# `~/.cyberclaw/bin/start-cyberclaw.sh` auto-wires
# `CYBERCLAW_POLICY_RULES_PATH=~/.cyberclaw/governance.yaml` when the file
# exists. To enable governance, copy this template:
#
#   cp docs/configuration/governance.yaml.example ~/.cyberclaw/governance.yaml
#
# Then restart the server. Boot log will show:
#   INFO cyberclaw_governance::rules: S27: policy rules loaded
#        path=/Users/<you>/.cyberclaw/governance.yaml rule_count=7
#
# Hot-reload (optional):
#   export CYBERCLAW_POLICY_RULES_RELOAD_SECS=10
#   # → server re-reads governance.yaml every 10s on mtime change.
#
# ## Format
#
# `RuleSet` (crates/cyberclaw-governance/src/rules.rs). One `rules:` list,
# each entry:
#   - kind:           "allow" | "deny"        (required)
#   - capability_id:  "fs.write"              (optional — null matches any)
#   - agent_id:       "trusted-agent"         (optional — null matches any)
#   - priority:       0..127                  (higher wins within Allow/Deny pass)
#   - reason:         "..."                   (optional — surfaced in audit)
#
# ## Evaluation order
#
# 1. Deny rules pass first (highest priority wins).
# 2. Allow rules pass next (highest priority wins).
# 3. Tie-break: earlier rule in file.
# 4. Unmatched → DefaultPolicyEngine (risk-threshold via
#    CYBERCLAW_POLICY_REVIEW_THRESHOLD: low|medium|high|critical, default low).
#
# ## Starter rules
#
# 7 conservative defaults every deployment benefits from. Add agent-specific
# overrides at the bottom.
rules:
  # 1. Block universally destructive shell patterns. Backstop in case
  # DangerousCapabilityFilter is reloaded out of sync.
  - kind: deny
    capability_id: cmd.run.rm_rf
    priority: 100
    reason: "rm -rf is irreversible; require explicit override per request"

  - kind: deny
    capability_id: cmd.run.mkfs
    priority: 100
    reason: "filesystem formatting is destructive; explicit override required"

  # 2. Network egress to private/RFC1918 ranges blocked by default.
  # Operators with internal services should add agent-specific allow rules.
  - kind: deny
    capability_id: browser.navigate.private_ip
    priority: 90
    reason: "private-IP egress blocked by default; add agent allow rules if needed"

  # 3. Audit log reads are unconditionally allowed (read-only diagnostic).
  - kind: allow
    capability_id: audit.read
    priority: 50
    reason: "audit log reads are read-only diagnostic, no risk"

  # 4. Memory writes from any agent. Per-agent isolation enforced inside
  # MemoryConnector (tenant_id scope), so rule-level allow is safe.
  - kind: allow
    capability_id: memory.write
    priority: 50
    reason: "memory writes are per-agent scoped at MemoryConnector"

  # 5. Browser navigate is High risk (arbitrary JS + network). The connector
  # is the source of truth; this rule documents that we trust connector
  # enforcement (BrowserConnector validates against private IPs above).
  - kind: allow
    capability_id: browser.navigate
    priority: 30
    reason: "browser navigate is High risk; auto-approve at admin discretion"

  # 6. fs.write enforced at LocalConnector workspace boundary
  # (BrowserConnector::validate_output_path equivalent). Rule mirrors intent.
  - kind: allow
    capability_id: fs.write
    priority: 30
    reason: "fs.write enforced at LocalConnector workspace boundary"

  # ----- Agent-specific overrides go below (examples, leave commented) -----
  #
  # - kind: allow
  #   agent_id: data-scientist
  #   capability_id: browser.navigate
  #   priority: 100
  #   reason: "data-scientist agent is trusted for browser tasks"
  #
  # - kind: deny
  #   agent_id: untrusted-helper
  #   capability_id: cmd.run
  #   priority: 100
  #   reason: "untrusted-helper cannot execute shell commands"
