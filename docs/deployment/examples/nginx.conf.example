# Nginx 反向代理配置示例
#
# 使用说明:
# 1. 复制此文件为 /etc/nginx/sites-available/cyberclaw
# 2. 修改下面的配置项:
#    - server_name: 替换为实际的域名
#    - proxy_pass: 根据 CyberClaw 服务的实际地址调整
#    - SSL 证书路径: 指向正确的证书文件
# 3. 启用配置: sudo ln -s /etc/nginx/sites-available/cyberclaw /etc/nginx/sites-enabled/
# 4. 测试配置: sudo nginx -t
# 5. 重新加载: sudo systemctl reload nginx
#
# 生产环境建议使用此配置来:
# - 终止 TLS/SSL 连接 (卸载 SSL)
# - 实现反向代理
# - 配置缓存
# - 实现负载均衡 (多个后端)
# - 提供额外的安全层

# ============================================
# 上游服务器定义
# ============================================
upstream cyberclaw_backend {
    # CyberClaw 服务的实际地址
    # 根据部署方式调整:
    # - Docker: localhost:3000
    # - Kubernetes: cyberclaw-service.default.svc.cluster.local:3000
    # - 远程主机: backend.internal.example.com:3000

    server localhost:3000;

    # 多服务器负载均衡 (可选)
    # server backend1.example.com:3000 weight=5;
    # server backend2.example.com:3000 weight=3;
    # server backend3.example.com:3000 backup;

    # 连接保活
    keepalive 32;
}

# ============================================
# HTTP 服务器 - 重定向到 HTTPS
# ============================================
server {
    listen 80;
    listen [::]:80;

    # 域名配置
    server_name cyberclaw.example.com api.cyberclaw.example.com;

    # 日志配置
    access_log /var/log/nginx/cyberclaw-access.log combined;
    error_log /var/log/nginx/cyberclaw-error.log warn;

    # Let's Encrypt 验证 (如果使用 Certbot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 其他所有请求重定向到 HTTPS
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# ============================================
# HTTPS 服务器
# ============================================
server {
    # SSL/TLS 监听配置
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    # 域名配置
    server_name cyberclaw.example.com api.cyberclaw.example.com;

    # ============================================
    # SSL/TLS 证书配置
    # ============================================

    # 证书文件路径
    # Let's Encrypt: /etc/letsencrypt/live/cyberclaw.example.com/fullchain.pem
    ssl_certificate /etc/letsencrypt/live/cyberclaw.example.com/fullchain.pem;

    # 证书私钥路径
    ssl_certificate_key /etc/letsencrypt/live/cyberclaw.example.com/privkey.pem;

    # 证书链文件 (可选但推荐)
    ssl_trusted_certificate /etc/letsencrypt/live/cyberclaw.example.com/chain.pem;

    # ============================================
    # SSL/TLS 性能优化
    # ============================================

    # 启用 OCSP Stapling (证书状态检查)
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # 会话缓存配置
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # ============================================
    # SSL/TLS 安全配置
    # ============================================

    # TLS 版本 - 仅支持安全版本
    ssl_protocols TLSv1.2 TLSv1.3;

    # 密码套件 - 优先级排序
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;

    # Diffie-Hellman 参数文件
    # 生成: openssl dhparam -out /etc/nginx/dhparam.pem 2048
    ssl_dhparam /etc/nginx/dhparam.pem;

    # ============================================
    # HTTP 安全头配置
    # ============================================

    # HSTS - 强制 HTTPS (初始值较短，验证后增加)
    # 初始: 300 秒 (5 分钟)
    # 生产: 31536000 秒 (1 年)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # 内容安全策略 - 防止 XSS
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:;" always;

    # 禁止 X-Frame-Options - 防止点击劫持
    add_header X-Frame-Options "DENY" always;

    # 禁止 Content-Type 嗅探
    add_header X-Content-Type-Options "nosniff" always;

    # 启用 XSS 保护
    add_header X-XSS-Protection "1; mode=block" always;

    # 控制引用信息
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 权限策略 (Feature Policy)
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()" always;

    # ============================================
    # 日志配置
    # ============================================

    access_log /var/log/nginx/cyberclaw-access.log combined;
    error_log /var/log/nginx/cyberclaw-error.log warn;

    # 访问日志格式 - 包含响应时间
    log_format cyberclaw_combined '$remote_addr - $remote_user [$time_local] '
                                  '"$request" $status $body_bytes_sent '
                                  '"$http_referer" "$http_user_agent" '
                                  'rt=$request_time uct="$upstream_connect_time" '
                                  'uht="$upstream_header_time" urt="$upstream_response_time"';

    # ============================================
    # 超时配置
    # ============================================

    # 客户端请求体超时
    client_body_timeout 30s;

    # 客户端请求头超时
    client_header_timeout 30s;

    # 发送响应超时
    send_timeout 30s;

    # keepalive 超时
    keepalive_timeout 65s;

    # ============================================
    # 代理配置
    # ============================================

    location / {
        # 代理到上游服务器
        proxy_pass http://cyberclaw_backend;

        # HTTP 版本
        proxy_http_version 1.1;

        # 代理请求头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket 支持 (如果需要)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # keepalive 连接复用
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # 超时配置
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # 缓冲配置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;

        # 禁用缓冲 (用于流式响应)
        # proxy_buffering off;
    }

    # ============================================
    # 缓存配置 (可选)
    # ============================================

    # 缓存静态资源 (如果有)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # 健康检查端点 - 不记录日志
    location = /health {
        access_log off;
        proxy_pass http://cyberclaw_backend;
    }

    # ============================================
    # 速率限制 (可选)
    # ============================================

    # 定义限制区域 (在 http 块中)
    # limit_req_zone $binary_remote_addr zone=cyberclaw_limit:10m rate=10r/s;
    #
    # limit_req zone=cyberclaw_limit burst=20 nodelay;

    # ============================================
    # 根路径重定向 (可选)
    # ============================================

    location = / {
        return 301 /health;
    }

    # ============================================
    # 404 错误页
    # ============================================

    error_page 404 = @not_found;
    location @not_found {
        default_type application/json;
        return 404 '{"error":"Not Found"}';
    }

    # ============================================
    # 5xx 错误页
    # ============================================

    error_page 500 502 503 504 = @error;
    location @error {
        default_type application/json;
        return 500 '{"error":"Internal Server Error"}';
    }
}

# ============================================
# 全局配置 (应放在 http 块中，不在此示例中)
# ============================================
#
# 以下配置应该在 /etc/nginx/nginx.conf 的 http 块中:
#
# # 隐藏 Nginx 版本信息
# server_tokens off;
#
# # Gzip 压缩
# gzip on;
# gzip_types text/plain text/css text/xml text/javascript
#            application/x-javascript application/xml+rss
#            application/json application/javascript;
# gzip_min_length 1000;
# gzip_comp_level 6;
#
# # 限制请求速率 (DDoS 防护)
# limit_req_zone $binary_remote_addr zone=one:10m rate=10r/s;
#
# # 连接数限制
# limit_conn_zone $binary_remote_addr zone=addr:10m;
# limit_conn addr 10;
#
# # 上游健康检查 (仅 nginx plus)
# # health_uri /health;
#
# # 日志格式
# log_format main '$remote_addr - $remote_user [$time_local] '
#                 '"$request" $status $body_bytes_sent '
#                 '"$http_referer" "$http_user_agent" '
#                 '"$http_x_forwarded_for" "$request_time"';
#
# access_log /var/log/nginx/access.log main;

# ============================================
# 自我签名证书生成 (用于测试)
# ============================================
#
# openssl req -x509 -newkey rsa:4096 \
#   -keyout /etc/nginx/key.pem \
#   -out /etc/nginx/cert.pem \
#   -days 365 -nodes \
#   -subj "/CN=localhost"
#
# Diffie-Hellman 参数生成:
# openssl dhparam -out /etc/nginx/dhparam.pem 2048
#
# 验证配置:
# sudo nginx -t
#
# 重新加载:
# sudo systemctl reload nginx
#
# 查看日志:
# sudo tail -f /var/log/nginx/cyberclaw-access.log
# sudo tail -f /var/log/nginx/cyberclaw-error.log
