# CyberClaw 生产环境配置示例
#
# 使用说明:
# 1. 复制此文件为 .env.production
# 2. 使用真实的 API 密钥和配置替换占位符
# 3. 设置适当的权限: chmod 600 .env.production
# 4. 不要将此文件提交到版本控制系统
#
# 危险: 此文件包含敏感信息，务必妥善保管

# ============================================
# 安全配置 (Security Configuration)
# ============================================

# JWT 签名密钥 - 生产环境强制
# 必需: 至少 32 字符的强随机字符串
# 生成方式: openssl rand -base64 32
JWT_SECRET=your-very-long-and-secure-secret-key-at-least-32-characters

# 运行环境 - 启用生产级安全特性
CYBERCLAW_ENV=production

# TLS/HTTPS 配置
USE_TLS=true
TLS_CERT_PATH=/etc/ssl/certs/cyberclaw.crt
TLS_KEY_PATH=/etc/ssl/private/cyberclaw.key

# ============================================
# LLM 配置 (LLM Provider Configuration)
# ============================================

# LLM 提供商选择
# 可选值: openai, anthropic, ark, generic
LLM_PROVIDER=openai

# LLM API 密钥
# 重要: 使用密钥管理服务，不要硬编码
LLM_API_KEY=sk-your-production-api-key

# LLM 基础 URL (可选，取决于提供商)
# OpenAI:    https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# ARK:       https://ark.cn-beijing.volces.com/api/v3
# Generic:   自定义 URL
LLM_BASE_URL=https://api.openai.com/v1

# ============================================
# 服务器配置 (Server Configuration)
# ============================================

# 服务器监听地址和端口
# 0.0.0.0:443 - 监听所有接口的 443 端口 (HTTPS)
CYBERCLAW_ADDR=0.0.0.0:443

# 请求超时时间 (秒)
CYBERCLAW_TIMEOUT=30

# 最大请求体大小 (字节)
# 默认: 10485760 (10MB)
# 单位: 字节
MAX_REQUEST_BODY_SIZE=10485760

# ============================================
# CORS 配置 (Cross-Origin Resource Sharing)
# ============================================

# CORS 允许的来源 (逗号分隔，无空格)
# 生产环境必须明确列出允许的域
# 不要使用通配符 (*)
CYBERCLAW_CORS_ORIGINS=https://app.cyberclaw.io,https://admin.cyberclaw.io,https://www.cyberclaw.io

# ============================================
# 速率限制 (Rate Limiting)
# ============================================

# 每秒允许的请求数
# 推荐值: 10-100 (根据实际负载调整)
RATE_LIMIT_PER_SECOND=50

# 允许的突发请求数
# 推荐值: 100-500 (根据实际负载调整)
RATE_LIMIT_BURST_SIZE=200

# ============================================
# 日志配置 (Logging Configuration)
# ============================================

# 日志级别
# 可选值: debug, info, warn, error
# 生产环境推荐: info 或 warn
RUST_LOG=info

# ============================================
# 高级配置 (Advanced Configuration)
# ============================================

# 数据库配置 (如果使用)
# DATABASE_URL=postgresql://user:password@localhost:5432/cyberclaw

# Redis 配置 (如果使用)
# REDIS_URL=redis://localhost:6379

# 外部监控服务
# SENTRY_DSN=https://your-sentry-project@sentry.io/your-project-id
# DATADOG_API_KEY=your-datadog-api-key
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ============================================
# 快速复制模板
# ============================================
#
# 基于上面的配置，生成命令行:
#
# export JWT_SECRET=$(openssl rand -base64 32)
# export LLM_API_KEY="sk-your-api-key"
# export CYBERCLAW_ADDR="0.0.0.0:443"
# export USE_TLS=true
# export CYBERCLAW_ENV=production
#
# docker-compose up -d
