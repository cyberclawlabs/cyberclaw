# Safe Multisig Connector — environment template

# Required: Safe instance
SAFE_ADDRESS=0x0000000000000000000000000000000000000000
SAFE_CHAIN_ID=1
SAFE_SERVICE_URL=https://safe-transaction-mainnet.safe.global
SAFE_SERVICE_API_KEY=

# Required: chain RPC for read / simulate / execute
ETH_RPC_URL=https://eth-mainnet.your-private-provider.example/key

# Required: this node's owner identity in signer-vault
SAFE_SIGNER_ID=ops-multisig-owner-A

# Optional: per-tx propose-time caps enforced at PolicyEngine
SAFE_ALLOWED_TO=                          # comma-separated allowlist; empty = no constraint
SAFE_MAX_VALUE_WEI=10000000000000000000   # 10 ETH = 10e18 wei

# Optional: log level
RUST_LOG=info,cyberclaw_connectors::web3::safe=debug
