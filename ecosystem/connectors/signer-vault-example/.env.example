# Signer Vault Connector — environment template

# ──────────────────────────────────────────────────────────────────────
# Signer: ops-treasury-1 (keystore backend)
# ──────────────────────────────────────────────────────────────────────
KEYSTORE_PATH=/var/cyberclaw/secrets/treasury-keystore.json
KEYSTORE_PASSWORD=change-me                   # 走 env，绝不写到 toml
OPS_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ──────────────────────────────────────────────────────────────────────
# Signer: ops-multisig-owner-A (AWS KMS backend)
# ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
KMS_KEY_ID_OWNER_A=arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000
OWNER_A_ADDRESS=0x0000000000000000000000000000000000000000
KMS_ASSUME_ROLE_ARN=arn:aws:iam::123456789012:role/cyberclaw-signer

# ──────────────────────────────────────────────────────────────────────
# Signer: ops-relay-1 (separate keystore — gas relayer for Safe execute)
# ──────────────────────────────────────────────────────────────────────
RELAY_KEYSTORE_PATH=/var/cyberclaw/secrets/relay-keystore.json
RELAY_KEYSTORE_PASSWORD=change-me

# ──────────────────────────────────────────────────────────────────────
# Logging — never logs key material; only signer_id, algorithm, payload hash
# ──────────────────────────────────────────────────────────────────────
RUST_LOG=info,cyberclaw_connectors::web3::signer=debug
