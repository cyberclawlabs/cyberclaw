# Ethereum Wallet Connector — environment template

# Required: EVM RPC endpoint
ETH_RPC_URL=https://eth-mainnet.your-private-provider.example/key

# Required: signer identity registered in signer-vault connector
WALLET_SIGNER_ID=ops-treasury-1

# Optional: chain selection
CHAIN_ID=1
CHAIN_LABEL=mainnet

# Optional: per-tx caps enforced at PolicyEngine
MAX_TX_VALUE_WEI=1000000000000000000      # 1 ETH = 1e18 wei
ALLOWED_TO_LIST=                          # comma-separated allowlist; empty = no constraint

# Optional: log level
RUST_LOG=info,cyberclaw_connectors::web3=debug
